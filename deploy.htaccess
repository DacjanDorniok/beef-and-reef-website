# Beef & Reef — statyczna strona (bez WordPressa)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# zawsze HTTPS i bez www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://beefandreef.pl/$1 [R=301,L]
# stare adresy WordPressa -> strona główna
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|feed|xmlrpc\.php)(/.*)?$ / [R=301,L,NC]
# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(webp|jpg|jpeg|png|svg|woff2|pdf|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

AddType image/webp .webp
AddType font/woff2 .woff2
